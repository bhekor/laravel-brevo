{
    "name": "bhekor/laravel-brevo",
    "description": "Laravel package for Brevo (ex-Sendinblue) API integration",
    "keywords": ["laravel", "brevo", "sendinblue", "email", "api"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your@email.com",
            "homepage": "https://yourwebsite.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "orchestra/testbench": "^7.0",
        "phpstan/phpstan": "^1.0",
        "mockery/mockery": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Bhekor\\LaravelBrevo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bhekor\\LaravelBrevo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bhekor\\LaravelBrevo\\BrevoServiceProvider"
            ],
            "aliases": {
                "Brevo": "Bhekor\\LaravelBrevo\\Facades\\Brevo"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}