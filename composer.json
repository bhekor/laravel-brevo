{
    "name": "bhekor/laravel-brevo",
    "description": "Laravel package for Brevo (ex-Sendinblue) API integration",
    "keywords": [
        "laravel",
        "brevo",
        "sendinblue",
        "email",
        "api",
        "transactional-email",
        "marketing",
        "sms"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ibidapo Adeolu",
            "email": "adeoluibidapo@gmail.com",
            "homepage": "https://bhekor.com.ng",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0",
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0",
        "phpstan/phpstan": "^1.10",
        "mockery/mockery": "^1.5",
        "laravel/pint": "^1.5",
        "nunomaduro/larastan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bhekor\\LaravelBrevo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bhekor\\LaravelBrevo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bhekor\\LaravelBrevo\\BrevoServiceProvider"
            ],
            "aliases": {
                "Brevo": "Bhekor\\LaravelBrevo\\Facades\\Brevo"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "check": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}